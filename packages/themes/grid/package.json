{
  "name": "@perch-app/theme-grid",
  "version": "0.1.0",
  "description": "perch theme — grid.",
  "keywords": [
    "perch",
    "theme",
    "grid",
    "static-site",
    "profile",
    "tailwind"
  ],
  "license": "MIT",
  "author": "HereNow Inc. (Imdaas)",
  "homepage": "https://perch.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/immmmmmmu/perch-oss.git",
    "directory": "packages/themes/grid"
  },
  "bugs": {
    "url": "https://github.com/immmmmmmu/perch-oss/issues"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "pnpm exec tailwindcss -i src/style.css -o dist/style.css --minify",
    "test": "vitest run --passWithNoTests"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@perch-app/core": "workspace:*",
    "@perch-app/themes-shared": "workspace:*"
  }
}
