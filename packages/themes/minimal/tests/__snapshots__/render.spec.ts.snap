<ul class="space-y-4"><li class="border-t pt-3">
<a href="https://example.com/p/1" class="font-medium hover:underline" rel="noopener" target="_blank">こんにちは &lt;world&gt;</a>
<div class="text-xs opacity-60">4/30/2026</div>
<p class="text-sm opacity-75 mt-1">intro &amp;amp; preview</p></li></ul></section>
</main>
</body></html>"
`;

