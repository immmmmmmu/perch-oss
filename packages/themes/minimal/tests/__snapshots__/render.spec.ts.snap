// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`@perch/theme-minimal > renders en snapshot 1`] = `
"<!doctype html><html lang="en"><head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>今田 慎一郎</title>
