{
  "name": "@perch/cli",
  "version": "0.1.0",
  "description": "CLI for self-hosted perch profile pages.",
  "keywords": [
    "perch",
    "cli",
    "static-site",
    "profile",
    "rss",
    "feed",
    "self-hosted"
  ],
  "license": "MIT",
  "author": "HereNow Inc. (Imdaas)",
  "homepage": "https://perch.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/immmmmmmu/perch-oss.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/immmmmmmu/perch-oss/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "perch": "bin/perch"
  },
  "main": "./dist/cli.mjs",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/cli.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@clack/prompts": "^1.3.0",
    "@perch/core": "workspace:*",
    "@perch/theme-card": "workspace:*",
    "@perch/theme-editorial": "workspace:*",
    "@perch/theme-grid": "workspace:*",
    "@perch/theme-minimal": "workspace:*",
    "@perch/theme-timeline": "workspace:*",
    "@perch/themes-shared": "workspace:*",
    "js-yaml": "^4.1.1",
    "marked": "^18.0.3",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^2.1.8",
    "tsup": "^8.5.1",
    "vitest": "^2.1.8"
  }
}
