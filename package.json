{
  "name": "perch-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "perch — 発信し続ける人のための、生きているプロフィールページ (OSS monorepo)",
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "lint": "pnpm --filter @perch-app/core build && eslint .",
    "lint:fix": "pnpm --filter @perch-app/core build && eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,astro,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md,astro,yaml,yml}\"",
    "typecheck": "pnpm --filter @perch-app/core build && pnpm -r typecheck",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "e2e": "pnpm --filter @perch-app/e2e test",
    "build": "pnpm -r --workspace-concurrency=1 build",
    "i18n:compile": "pnpm --filter @perch-app/i18n compile",
    "i18n:check": "pnpm --filter @perch-app/i18n check",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "pnpm -r --filter \"@perch-app/*\" build && changeset publish",
    "release:dryrun": "bash scripts/release-dryrun.sh",
    "release:smoke": "bash scripts/smoke-test-npm.sh",
    "preinstall": "npx only-allow pnpm"
  },
  "pnpm": {
    "overrides": {
      "devalue": "5.8.1",
      "esbuild": "0.28.2",
      "fast-xml-builder": ">=1.1.7",
      "fast-uri": "3.1.5",
      "hono": "4.13.1",
      "js-cookie": "3.0.7",
      "kysely": ">=0.28.17",
      "nanoid": "3.3.17",
      "postcss": "8.5.23",
      "sharp": "0.35.3",
      "svgo": "4.0.2",
      "undici": "7.29.0",
      "yaml": "2.8.3"
    }
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.10",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/cli": "4.2.4",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "globals": "^17.6.0",
    "only-allow": "^1.2.1",
    "prettier": "^3.4.2",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^2.1.8"
  }
}
